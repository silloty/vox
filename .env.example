# VOX - Sistema de Ouvidoria
# Copie para .env e preencha os valores. O arquivo .env não deve ser commitado.

# Banco de Dados
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vox
DB_USER=usrvox
# Obrigatória. Sem esta senha o Compose não inicia o Postgres.
DB_PASS=
DB_SCHEMA=public

# Aplicação
APP_NAME="VOX - Sistema de Ouvidoria"
APP_URL=http://localhost:8001
APP_ENV=development
APP_INSTITUTION="Minha Instituição"

# Email (Ouvidoria)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_ADMIN_ADDRESS=

# Manifestação
MAX_CHARS_MANIFESTACAO=2000

# Administrador criado apenas na primeira inicialização do volume do Postgres.
# Deixe ADMIN_PASSWORD vazio para gerar uma senha aleatória nessa ocasião.
ADMIN_LOGIN=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
